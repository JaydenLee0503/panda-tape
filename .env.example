# Copy this file to `.env` and fill in your values.
# Only VITE_* vars are read by the frontend (and bundled into the public client).

# ---- ElevenLabs support widget ----
# Conversational AI agent ID for the support widget.
# Find it in the ElevenLabs dashboard: Conversational AI > your agent > Widget.
# This is a PUBLIC/embeddable identifier — safe to expose in the client.
VITE_ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# NOTE: never put a secret ElevenLabs API key (sk_...) in a VITE_ variable —
# VITE_ vars are bundled into the public client. Secret keys belong server-side.

# ---- Supabase (backend: drop-off map proxy + reservations) ----
# From your Supabase project: Settings > API.
# Both are PUBLIC client keys — safe to expose in the browser. The anon key only
# grants what row-level security allows.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- Foursquare (SERVER-SIDE ONLY — do NOT put it here) ----
# The Foursquare Places key powers the live drop-off map, but it must never ship
# to the browser. It lives as a Supabase Edge Function secret, read by the
# `places` function (supabase/functions/places/index.ts). Set it with:
#
#   npx supabase secrets set FOURSQUARE_API_KEY=your_key_here
#
# There is intentionally no VITE_FOURSQUARE_API_KEY anymore.
