# Copy this file to `.env` and fill in your values.
#
# ElevenLabs Conversational AI agent ID for the support widget.
# Find it in the ElevenLabs dashboard: Conversational AI > your agent > Widget.
# This is a PUBLIC/embeddable identifier — safe to expose in the client.
VITE_ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NOTE: never put a secret ElevenLabs API key (sk_...) in a VITE_ variable —
# VITE_ vars are bundled into the public client. Secret keys belong in
# server-side env only.
